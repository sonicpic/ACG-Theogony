# ── LLM 提供方（OpenAI 兼容协议，至少配置一个）──────────────────────────
# DeepSeek：数据增强 / 关系挖掘 / GraphRAG 生成
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# gpt-luna-5.6：带联网检索能力的模型，用于 wiki 研究 / RAG 增强。
# 填入 key 后自动激活（pipelines.research / 语义检索优先走它）
LUNA_API_KEY=
LUNA_API_BASE=https://api.luna.example.com/v1
LUNA_MODEL=gpt-luna-5.6
# 若服务端需要额外参数开启联网（如 {"enable_search": true}），在此以 JSON 配置
LUNA_EXTRA_BODY={}

# ── 语义检索 / RAG 嵌入向量（可选，OpenAI 兼容 /embeddings 端点）────────
# 未配置时自动回退到 FTS5 词法检索 + 图检索，功能不缺失，仅召回略降
EMBEDDINGS_API_KEY=
EMBEDDINGS_API_BASE=
EMBEDDINGS_MODEL=

# ── 服务 ─────────────────────────────────────────────────────────────
# 审核后台令牌（留空则不鉴权，本地部署可留空）
REVIEW_TOKEN=
CORS_ORIGINS=http://localhost:3000
