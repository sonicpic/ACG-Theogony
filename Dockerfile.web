# 单容器全栈镜像：Python(FastAPI) + Node(Next.js) + 进程守护入口
# host 网络下对外只暴露 WEB_PORT(58115)；API 仅监听容器回环 127.0.0.1:8000

# Node 22 二进制来源（不做 apt/外网下载，直接从官方镜像拷贝）
FROM node:22-bookworm-slim AS node-dist

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim
COPY --from=node-dist /usr/local/bin/node /usr/local/bin/node
COPY --from=node-dist /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

WORKDIR /repo

# Python 依赖层（保持缓存稳定；hatchling 单独一层，装一次即缓存）
COPY README.md pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev
RUN uv pip install hatchling

# 前端依赖层
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm ci --no-audit --no-fund --workspace-root

# 项目与数据
COPY theogony ./theogony
COPY data ./data
COPY docker ./docker
COPY . .
# --no-build-isolation：复用上面缓存的 hatchling，源码改动重构建时不碰网络
RUN uv sync --frozen --no-dev --no-build-isolation

# 前端构建（rewrites 在 build 期固化，API 地址必须此时注入）
RUN npm run gen:types
ENV NEXT_TELEMETRY_DISABLED=1
ARG API_ORIGIN=http://127.0.0.1:18000
ENV API_ORIGIN=${API_ORIGIN}
RUN npm run build -w apps/web

ENV TZ=Asia/Shanghai NODE_ENV=production
EXPOSE 58115
CMD ["python", "docker/entrypoint.py"]
