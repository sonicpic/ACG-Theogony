# Next.js 镜像（多阶段构建）
FROM node:22-alpine AS deps
WORKDIR /repo
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm ci --no-audit --no-fund --workspace-root

FROM node:22-alpine AS builder
WORKDIR /repo
COPY --from=deps /repo/node_modules ./node_modules
COPY . .
# 构建期类型从已提交的 data/openapi.json 生成（无需后端在线）
RUN npm run gen:types
ENV NEXT_TELEMETRY_DISABLED=1
# rewrites 会在 next build 时固化进路由清单，因此 API 地址必须作为构建参数传入
ARG API_ORIGIN=http://api:8000
ENV API_ORIGIN=${API_ORIGIN}
RUN npm run build -w apps/web

FROM node:22-alpine AS runner
WORKDIR /repo
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=builder /repo/apps/web/.next ./apps/web/.next
COPY --from=builder /repo/apps/web/public ./apps/web/public
COPY --from=builder /repo/apps/web/package.json ./apps/web/
COPY --from=builder /repo/apps/web/next.config.ts ./apps/web/
COPY --from=builder /repo/node_modules ./node_modules
COPY --from=builder /repo/package.json ./
EXPOSE 3000
WORKDIR /repo/apps/web
CMD ["npx", "next", "start", "-p", "3000"]
